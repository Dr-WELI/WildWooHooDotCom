<script>
(function(){
  /* the method picture: scattered points glide once into a wave when the plot scrolls into view */
  var g=document.getElementById('dots'),n=34,seed=7;
  if(g){
    function r(){seed=(seed*9301+49297)%233280;return seed/233280;}
    for(var i=0;i<n;i++){
      var x=60+r()*430,y=28+r()*270,tx=64+i*(420/(n-1)),ty=168+Math.sin(i/n*Math.PI*3)*72;
      var c=document.createElementNS('http://www.w3.org/2000/svg','circle');
      c.setAttribute('cx',x.toFixed(1));c.setAttribute('cy',y.toFixed(1));c.setAttribute('r',i===21?7:5.5);
      c.setAttribute('class','dot'+(i===21?' you':''));
      c.style.setProperty('--dx',(tx-x).toFixed(1)+'px');c.style.setProperty('--dy',(ty-y).toFixed(1)+'px');
      g.appendChild(c);
    }
    var plot=document.getElementById('plot');
    var still=matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(still||!('IntersectionObserver' in window)){plot.classList.add('moved');}
    else{var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){setTimeout(function(){plot.classList.add('moved');},250);io.disconnect();}});},{threshold:.45});io.observe(plot);}
  }
  /* the video loads from YouTube only when someone presses play */
  document.querySelectorAll('.video-facade').forEach(function(box){
    var btn=box.querySelector('.play');
    btn.addEventListener('click',function(){
      var f=document.createElement('iframe');
      f.src='https://www.youtube-nocookie.com/embed/'+box.getAttribute('data-yt')+'?autoplay=1&rel=0';
      f.title='Kangaroo Time, the music video';
      f.allow='autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen=true;
      box.innerHTML='';box.appendChild(f);f.focus();
    });
  });
})();
</script>
