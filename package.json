{
  "name": "wildwoohoo-com",
  "private": true,
  "description": "The build for wildwoohoo.com: plain HTML, one shared design system, published to GitHub Pages by GitHub Actions.",
  "scripts": {
    "build": "rm -rf _site && eleventy && node scripts/verify-build.mjs",
    "dev": "eleventy --serve --port 4173",
    "verify": "node scripts/verify-build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@11ty/eleventy-img": "7.1.1"
  }
}
